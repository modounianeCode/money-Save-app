{
  "name": "money-save",
  "version": "1.0.0",
  "private": true,
  "description": "Application de gestion de budget personnel",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace server & npm run dev --workspace client",
